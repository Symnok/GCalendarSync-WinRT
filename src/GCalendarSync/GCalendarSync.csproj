<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">ARM</Platform>
    <ProjectGuid>{9CE388AE-52DB-4BA9-9B4E-061373939755}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>GCalendarSync</RootNamespace>
    <AssemblyName>GCalendarSync</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformIdentifier>WindowsPhoneApp</TargetPlatformIdentifier>
    <TargetPlatformVersion>8.1</TargetPlatformVersion>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{76F1466A-8B6D-4E39-A767-685A06062A39};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <!-- Signing must be turned on explicitly: without AppxPackageSigningEnabled the build happily
         produces an UNSIGNED appx and says nothing, and an unsigned package cannot be deployed.
         The certificate subject must equal the manifest's Publisher (CN=GCalendarSync)
         exactly. Install the matching .cer on the phone once, before the app. -->
    <PackageCertificateKeyFile>GCalendarSync_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
  </PropertyGroup>

  <!--
    Architecture-specific only because of the native TLS component: a WP8.1 package that contains
    native code cannot be AnyCPU. ARM ships to devices, x86 runs in the emulator.
  -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|ARM' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\ARM\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_PHONE_APP</DefineConstants>
    <NoWarn>;2008</NoWarn>
    <DebugType>full</DebugType>
    <PlatformTarget>ARM</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|ARM' ">
    <OutputPath>bin\ARM\Release\</OutputPath>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_PHONE_APP</DefineConstants>
    <Optimize>true</Optimize>
    <NoWarn>;2008</NoWarn>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>ARM</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>true</Prefer32Bit>
    <UseDotNetNativeToolchain>false</UseDotNetNativeToolchain>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_PHONE_APP</DefineConstants>
    <NoWarn>;2008</NoWarn>
    <DebugType>full</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\x86\Release\</OutputPath>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_PHONE_APP</DefineConstants>
    <Optimize>true</Optimize>
    <NoWarn>;2008</NoWarn>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x86</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>true</Prefer32Bit>
    <UseDotNetNativeToolchain>false</UseDotNetNativeToolchain>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="MainPage.xaml.cs">
      <DependentUpon>MainPage.xaml</DependentUpon>
    </Compile>
    <Compile Include="Pages\SettingsPage.xaml.cs">
      <DependentUpon>SettingsPage.xaml</DependentUpon>
    </Compile>
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Pages\SettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <None Include="GCalendarSync_TemporaryKey.pfx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Logo.scale-240.png" />
    <Content Include="Assets\SmallLogo.scale-240.png" />
    <Content Include="Assets\SplashScreen.scale-240.png" />
    <Content Include="Assets\StoreLogo.scale-240.png" />
    <Content Include="Assets\Square71x71Logo.scale-240.png" />
  </ItemGroup>

  <!-- The trust bundle travels inside the package; TrustBundle.cs reads it at the start of every
       sync and hands the bytes to the native TLS component. -->
  <ItemGroup>
    <Content Include="..\..\certs\mozilla-cacert.pem">
      <Link>Assets\google-cacert.pem</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The app is per-architecture because of the native component, but Core and the background
         task are plain managed code and stay AnyCPU; map the platform explicitly so building the
         app outside a solution does not ask them for a Release|ARM they do not have. -->
    <ProjectReference Include="..\GCalendarSync.Core\GCalendarSync.Core.csproj">
      <Project>{a74f9006-6de1-4061-9a72-bbb5f60cb7c9}</Project>
      <Name>GCalendarSync.Core</Name>
      <SetPlatform>Platform=AnyCPU</SetPlatform>
    </ProjectReference>
    <!-- A real ProjectReference so the component's .winmd is packaged and the activatableClass
         registration is emitted - the background host needs both to activate PeriodicSyncTask. -->
    <ProjectReference Include="..\GCalendarSync.BackgroundTasks\GCalendarSync.BackgroundTasks.csproj">
      <Project>{35fc9c9d-5174-46ab-8434-b6fb6b8dd7eb}</Project>
      <Name>GCalendarSync.BackgroundTasks</Name>
      <SetPlatform>Platform=AnyCPU</SetPlatform>
    </ProjectReference>
  </ItemGroup>

  <!--
    The native component is a real ProjectReference, NOT a file reference to its .winmd. This
    matters: only a ProjectReference makes the packaging targets
      * copy GCalendarSync.Tls.winmd into the package (.NET needs it at runtime to resolve the
        type - a file reference leaves it out and the app dies on first use),
      * emit the <Extensions><Extension Category="windows.activatableClass.inProcessServer">
        registration without which the WinRT class cannot be activated at all, and
      * pull in the VCLibs 12.00 framework dependency the native CRT needs
        (msvcr120_app / msvcp120_app / vccorlib120_app are not in our package).

    Its two non-default build properties (see GCalendarSync.Tls\build-tls.bat) are handed over
    as AdditionalProperties so the reference builds correctly from here too.
  -->
  <PropertyGroup>
    <TlsVCTargets>C:\Program Files (x86)\MSBuild\Microsoft.Cpp\v4.0\V120\</TlsVCTargets>
    <TlsXamlTargets>C:\Program Files (x86)\MSBuild\Microsoft\WindowsXaml\v14.0\Microsoft.Windows.UI.Xaml.Cpp.targets</TlsXamlTargets>
    <TlsPlatform Condition="'$(Platform)'=='ARM'">ARM</TlsPlatform>
    <TlsPlatform Condition="'$(Platform)'=='x86'">Win32</TlsPlatform>
    <OpenSslBin Condition="'$(Platform)'=='ARM'">$(MSBuildProjectDirectory)\..\..\lib\openssl\wp81-arm-v120\bin</OpenSslBin>
    <OpenSslBin Condition="'$(Platform)'=='x86'">$(MSBuildProjectDirectory)\..\..\lib\openssl\wp81-x86-v120\bin</OpenSslBin>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GCalendarSync.Tls\GCalendarSync.Tls.vcxproj">
      <Project>{95999de9-65d6-4c01-bb25-c14464fc30ab}</Project>
      <Name>GCalendarSync.Tls</Name>
      <SetPlatform>Platform=$(TlsPlatform)</SetPlatform>
      <AdditionalProperties>VCTargetsPath=$(TlsVCTargets);_CppCommonExtensionTargets=$(TlsXamlTargets)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- OpenSSL itself is a plain native DLL pair with no WinRT metadata, so it is simply copied
       into the package. -->
  <ItemGroup>
    <Content Include="$(OpenSslBin)\libeay32.dll">
      <Link>libeay32.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(OpenSslBin)\ssleay32.dll">
      <Link>ssleay32.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
