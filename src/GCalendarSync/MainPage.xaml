<Page
    x:Class="GCalendarSync.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="LoadCredentialsCmd" Label="load credentials from file"
                              Click="OnLoadCredentialsClick" />
                <AppBarButton x:Name="SettingsCmd" Label="settings" Click="OnSettingsClick" />
                <AppBarButton x:Name="ForgetCmd" Label="forget account" Click="OnForgetClick" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <ScrollViewer>
        <StackPanel Margin="19,12,19,24">

            <TextBlock Text="google calendar" Margin="0,8,0,0"
                       Style="{ThemeResource TitleTextBlockStyle}" Opacity="0.7" />
            <TextBlock Text="GCalendarSync" Margin="0,0,0,4"
                       Style="{ThemeResource HeaderTextBlockStyle}" />

            <!-- ACCOUNT -->
            <TextBlock Text="Gmail address" FontSize="15" Margin="0,16,0,4" />
            <TextBox x:Name="EmailBox" InputScope="EmailSmtpAddress" FontSize="20" />

            <TextBlock Text="App Password - not your Gmail password"
                       FontSize="15" Margin="0,12,0,4" />
            <PasswordBox x:Name="PasswordBox" FontSize="20" />
            <TextBlock Text="Create one at myaccount.google.com/apppasswords. It is 16 characters and needs 2-Step Verification switched on."
                       TextWrapping="Wrap" FontSize="13" Opacity="0.6" Margin="0,4,0,0" />

            <CheckBox x:Name="RememberBox" Content="remember on this phone"
                      IsChecked="True" Margin="0,8,0,8" />

            <!-- SYNC -->
            <Button x:Name="DownloadButton" Content="sync from Google"
                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                    Click="OnDownloadClick" />
            <TextBlock Text="Events come from Google to the phone, and only that way. Nothing you change in the phone's Calendar is ever sent back. Downloading also runs on a timer in the background."
                       TextWrapping="Wrap" FontSize="13" Opacity="0.6" Margin="0,6,0,0" />

            <!-- PROGRESS -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" />
                <TextBlock x:Name="ProgressText" FontSize="15" TextWrapping="Wrap"
                           Opacity="0.8" Margin="0,8,0,0" />
            </StackPanel>

            <!-- RESULT -->
            <Border x:Name="ResultBanner" Visibility="Collapsed" Margin="0,16,0,0"
                    Padding="12,10" Background="#2E7D32">
                <TextBlock x:Name="ResultText" FontSize="15" TextWrapping="Wrap"
                           Foreground="White" />
            </Border>

            <Border x:Name="ErrorBanner" Visibility="Collapsed" Margin="0,16,0,0"
                    Padding="12,10" Background="#B71C1C">
                <StackPanel>
                    <TextBlock Text="sync failed" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" Margin="0,0,0,4" />
                    <TextBlock x:Name="ErrorText" FontSize="14" TextWrapping="Wrap"
                               Foreground="White" />
                </StackPanel>
            </Border>

            <!-- STATUS -->
            <TextBlock Text="status" Margin="0,24,0,0"
                       Style="{ThemeResource SubheaderTextBlockStyle}" />
            <TextBlock x:Name="LastDownloadText" FontSize="14" Opacity="0.7"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock x:Name="AutoSyncText" FontSize="14" Opacity="0.7"
                       TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock x:Name="AutoSyncErrorText" FontSize="14" Opacity="0.7"
                       TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="VersionText" FontSize="13" Opacity="0.4"
                       Margin="0,8,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
